<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web-app</title>
    <link rel="icon" href="/stili/icone/mappamondo.png" type="image/png">
    <link rel="stylesheet"href="/Stili/login.css"/>
    <script>
        const id_album = window.location.pathname.split('/').pop();
        async function chiedi_foto(id_album) {
            const ric = await fetch(`/fotoAlbum/${id_album}`);
            const ft_js = await ric.json();
            const divisore = document.getElementById('griglia');
            divisore.innerHTML='';
            for (var i=0; i<ft_js.length; i++){
                console.log(ft_js[i]);
                divisore.innerHTML += `<input type="radio" id="img${i}" name="foto_copertina" value="${ft_js[i].nome_foto}"> <label for="img${i}" class="tit_foto">
                                <img src="/${ft_js[i].nome_foto}" class="foto_c">
                                </label>`;

            }
        }
        
        
    </script>
</head>
<body>
    <div id="finestra">
        <form action="/cambia_copertina" method="POST">
        <h1>Scegli la nuova foto per la copertina</h1>
        <input type="hidden" name="id_album" id="id_album">
        <div id="griglia" class="griglia_foto">
        </div>
        <button type="submit">Cambia</button>
        <% if (risposta) { %>
           <script>window.close();</script>
        <% } %>
        </form>
    </div>
    
</body>
<script>
    chiedi_foto(id_album);
    document.getElementById("id_album").value = id_album;
</script>
</html>