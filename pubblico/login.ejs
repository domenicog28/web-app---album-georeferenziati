<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web-app</title>
    <link rel="stylesheet"href="./Stili/login.css"/>
    <script>
        function registrazione(){
            window.location.href="/registrazione";
        }
    </script>
    <link rel="icon" href="/stili/icone/mappamondo.png" type="image/png">
</head>
<body>
    <div class="container">
        <h1>Login</h1>
            <form action="/accedi" method="post">
                <label for="email">E-mail</label>
                <input type="email" id="Email" name="email" required>
                <label for="password">Password</label>
                <input type="password" id="Password" name="password" required>
                
                
                <% if (errore) { %>
                    <div id="messaggioErrore">
                        <%= errore %>
                    </div>
                <% } %>
                <button type="submit">Accedi</button>
                <button onclick="registrazione()">Registrazione</button>
            </form>
    </div>    
</body>
</html>